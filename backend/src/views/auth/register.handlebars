<div class="auth-wrapper">
  <div class="auth-card">
    <!-- Logo -->
    <div class="text-center mb-4">
      <span class="auth-logo">🌸</span>
      <h2 class="fw-bold mt-2 mb-0">Crea tu cuenta</h2>
      <p class="text-muted">Únete a MoonBloom y conoce tu ciclo</p>
    </div>

    {{#if error}}
    <div class="alert alert-danger border-0 rounded-3 py-2" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>{{error}}
    </div>
    {{/if}}

    <form action="/registro" method="POST" class="mb-form" novalidate>
      <div class="mb-3">
        <label for="name" class="form-label">Nombre completo</label>
        <div class="input-group-icon">
          <i class="bi bi-person-fill field-icon"></i>
          <input type="text" id="name" name="name" class="form-control ps-5"
            placeholder="Luna García" required />
        </div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Correo electrónico</label>
        <div class="input-group-icon">
          <i class="bi bi-envelope-fill field-icon"></i>
          <input type="email" id="email" name="email" class="form-control ps-5"
            placeholder="luna@ejemplo.com" required />
        </div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label">Contraseña</label>
        <div class="input-group-icon">
          <i class="bi bi-lock-fill field-icon"></i>
          <input type="password" id="password" name="password" class="form-control ps-5"
            placeholder="Mínimo 6 caracteres" required minlength="6" />
        </div>
      </div>

      <button type="submit" class="btn btn-moon w-100 py-2 fs-6">
        <i class="bi bi-stars me-2"></i>Crear mi cuenta
      </button>
    </form>

    <p class="text-center text-muted mt-4 mb-0">
      ¿Ya tienes cuenta?
      <a href="/login" class="fw-semibold text-decoration-none" style="color:var(--mb-primary);">Inicia sesión</a>
    </p>
  </div>
</div>
