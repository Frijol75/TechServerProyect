<!-- ── Cabecera ───────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-0"><i class="bi bi-people-fill me-2" style="color:var(--mb-primary);"></i>Usuarias</h2>
    <span class="text-muted">{{count}} registrada(s)</span>
  </div>
  <a href="/usuarios/nuevo" class="btn btn-moon">
    <i class="bi bi-person-plus-fill me-2"></i>Registrar nueva usuaria
  </a>
</div>

<!-- ── Tabla ──────────────────────────────────────────────────────────── -->
{{#if users.length}}
<div class="mb-card p-0 overflow-hidden">
  <table class="table mb-table mb-0">
    <thead>
      <tr>
        <th class="ps-4">Nombre</th>
        <th>Correo electrónico</th>
        <th>Fecha de registro</th>
      </tr>
    </thead>
    <tbody>
      {{#each users}}
      <tr>
        <td class="ps-4 fw-medium">{{this.name}}</td>
        <td>{{this.email}}</td>
        <td>{{this.createdAt}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<div class="mb-card empty-state">
  <span class="empty-icon">👤</span>
  <h5 class="fw-semibold mb-1">No hay usuarias registradas aún</h5>
  <p class="text-muted mb-3">Comienza registrando la primera usuaria de MoonBloom.</p>
  <a href="/usuarios/nuevo" class="btn btn-moon">Registrar ahora</a>
</div>
{{/if}}
