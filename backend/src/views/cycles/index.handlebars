<!-- ── Cabecera ───────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-0">
      <i class="bi bi-calendar-heart-fill me-2" style="color:var(--mb-primary);"></i>Ciclos
    </h2>
    <span class="text-muted">{{count}} ciclo(s) registrado(s)</span>
  </div>
</div>

<!-- ── Tabla ──────────────────────────────────────────────────────────── -->
{{#if cycles.length}}
<div class="mb-card p-0 overflow-hidden">
  <table class="table mb-table mb-0">
    <thead>
      <tr>
        <th class="ps-4">Usuaria</th>
        <th>Correo</th>
        <th>Inicio del ciclo</th>
        <th>Fin del ciclo</th>
        <th>Duración</th>
        <th>Notas</th>
      </tr>
    </thead>
    <tbody>
      {{#each cycles}}
      <tr>
        <td class="ps-4 fw-medium">{{this.userId.name}}</td>
        <td>{{this.userId.email}}</td>
        <td>{{this.startDate}}</td>
        <td>{{this.endDate}}</td>
        <td>
          {{#if this.durationDays}}
            <span class="badge-cycle">{{this.durationDays}} días</span>
          {{else}}
            <span class="text-muted">—</span>
          {{/if}}
        </td>
        <td>
          {{#if this.notes}}
            {{this.notes}}
          {{else}}
            <span class="text-muted">Sin notas</span>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<div class="mb-card empty-state">
  <span class="empty-icon">📅</span>
  <h5 class="fw-semibold mb-1">No hay ciclos registrados aún</h5>
  <p class="text-muted mb-3">Registra tu primer ciclo para empezar a llevar tu seguimiento.</p>
  <a href="/ciclos/nuevo" class="btn btn-moon">
    <i class="bi bi-plus-circle-fill me-1"></i>Crear mi primer ciclo
  </a>
</div>
{{/if}}
